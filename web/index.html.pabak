async function doDelete(aid){































  if(!confirm('确定删除该智能体？此操作不可恢复。')) return;































  await api('/api/agents/' + aid, {method:'DELETE'});































  S.cur = null; S.editing = null; render();































}































async function doArchive(aid){

  if(!confirm('归档后业务人员将无法执行该智能体，确定归档？')) return;

  try{ await api('/api/agents/' + aid + '/archive', {method:'POST'}); S.editing=null; render(); }

  catch(e){ msg('edmsg','err', e.message); }

}

async function doUnarchive(aid){

  try{ await api('/api/agents/' + aid + '/unarchive', {method:'POST'}); S.editing=null; render(); }

  catch(e){ msg('edmsg','err', e.message); }

}

async function doEnableToggle(aid){    try{ const E2 = S.agents.find(a=>a.id===aid); const on = !(E2 ? E2.enabled : true);      await api('/api/agents/' + aid + '/enable', {method:'POST', body:JSON.stringify({on:on})});      render(); setTimeout(function(){ msg('edmsg','ok', on?'已启用':'已停用'); }, 50); }    catch(e){ msg('edmsg','err', e.message); } }  async function viewVersions(aid){

  const p = $('verPanel');

  if(p.dataset.open === '1'){ p.innerHTML=''; p.dataset.open='0'; return; }

  p.dataset.open='1';

  const esc2 = function(s){ return String(s).replace(/[&<>]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c]; }); };

  p.innerHTML = '<div class="small" style="margin-bottom:6px">版本历史（回滚将恢复该版本定义并重新发布）：</div>';

  try{

    const r = await api('/api/agents/' + aid + '/versions');

    if(!r.items.length){ p.innerHTML += '<div class="small">暂无历史版本</div>'; return; }

    for(const v of r.items){

      const t = new Date((v.created_at||0)*1000).toLocaleString();

      p.innerHTML += '<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-top:1px solid rgba(128,128,128,0.3)">' +

        '<div><b>v' + v.version + '</b> <span class="small">' + esc2(v.note||'') + '</span><br><span class="small" style="opacity:0.6">' + t + '</span></div>' +

        '<button class="sm" onclick="doRollback(\'' + aid + '\',' + v.version + ')">回滚</button></div>';

    }

  }catch(e){ p.innerHTML = '<div class="err">' + esc2(e.message) + '</div>'; }

}

async function doRollback(aid, ver){

  if(!confirm('回滚到 v' + ver + '？将恢复该版本定义并重新发布（生成新版本号）。')) return;

  try{

    const r = await api('/api/agents/' + aid + '/rollback/' + ver, {method:'POST'});

    S.editing=null; render();

    setTimeout(function(){ msg('edmsg','ok','已回滚至 v' + ver + '，当前版本 v' + (r.version||'?') ); }, 60);

  }catch(e){ msg('edmsg','err', e.message); }

}



async function doTest(){































  const body = collect();































  if(!body.name){ msg('edmsg', 'err', '请先填写名称并保存'); return; }































  let aid = S.cur;































  try{































    const r = S.cur ? await api('/api/agents/' + S.cur, {method:'PUT', body:JSON.stringify(body)})































                    : await api('/api/agents', {method:'POST', body:JSON.stringify(body)});































    aid = r.id; S.cur = aid;































  }catch(e){ msg('edmsg', 'err', e.message); return; }































  const a = await api('/api/agents/' + aid);































  $('testout').innerHTML = '<div class="card" style="margin-top:12px"><b>试运行</b>' +































    '<div class="small" style="margin:4px 0 8px">用当前配置真跑一遍，验证技能与工具是否生效</div>' +































    '<div id="tform">' + formHTML(a.input_schema, 't') + '</div>' +































    '<button class="sm" style="margin-top:8px" onclick="runTest(\'' + aid + '\')">开始试运行</button>' +































    '<div id="tout"></div></div>';































}































async function runTest(aid){































  const a = await api('/api/agents/' + aid);































  const miss = checkForm(a.input_schema, 't');































  if(miss.length){ $('tout').innerHTML = '<div class="err">请填写：' + esc(miss.join('、')) + '</div>'; return; }































  $('tout').innerHTML = '<div class="small">执行中…</div>';































  try{































    const r = await api('/api/agents/' + aid + '/test', {method:'POST',































      body:JSON.stringify({input:readForm(a.input_schema, 't')})});































    $('tout').innerHTML = (r.status === 'done'































        ? '<div class="ok">试运行成功 · 耗时 ' + r.seconds + 's</div>'































        : '<div class="err">失败：' + esc(r.error || r.status) + '</div>') +































      (r.tool_calls && r.tool_calls.length ? '<div class="small" style="margin:8px 0 4px">工具调用</div>' +































        '<table><tr><th>轮次</th><th>工具</th><th>结果</th><th>耗时</th></tr>' +































        r.tool_calls.map(c => '<tr><td>' + c.round + '</td><td>' + esc(c.tool) + '</td><td>' +































          (c.ok ? '成功' : '失败') + '</td><td>' + c.ms + 'ms</td></tr>').join('') + '</table>' : '') +































      (r.answer ? '<div class="small" style="margin:10px 0 4px">输出</div><pre>' + esc(r.answer) + '</pre>' : '') +































      (r.artifacts.length ? '<div class="small" style="margin:8px 0 4px">产物</div>' +































        r.artifacts.map(x => '<div class="kv"><span>' + esc(x.name) + '</span>' +































          '<button class="sm" onclick="dl(\'' + x.id + '\')">下载</button></div>').join('') : '');































  }catch(e){ $('tout').innerHTML = '<div class="err">' + esc(e.message) + '</div>'; }































}































async function viewPrompt(){































  if(!S.cur){ msg('edmsg', 'err', '请先保存智能体'); return; }































  const d = await api('/api/agents/' + S.cur + '/prompt');































  openModal('<h3>生效提示词预览</h3><div class="small" style="margin-bottom:8px">' +































    '引擎：' + esc(d.runtime) + ' · 技能：' + esc((d.skills || []).join(', ') || '无') +































    ' · 工具：' + esc((d.tools || []).join(', ') || '无') + '</div><pre>' + esc(d.system) + '</pre>' +































    '<div class="row" style="margin-top:12px"><button class="ghost" onclick="closeModal()">关闭</button></div>');































}































































/* ------------------------------------------------------------ 技能库 */































async function viewSkill(v, seq){































  const d = await api('/api/skills');































  let h = '<div class="flex" style="gap:16px;align-items:flex-start">' +































    '<div style="width:300px"><div class="card"><div class="row" style="margin-bottom:10px"><b>技能包</b>' +































    '<span class="spacer" style="flex:1"></span><button class="sm" onclick="newSkill()">+ 新建</button></div>' +































    (d.items.length ? d.items.map(s => '<div class="list-item" onclick="editSkill(\'' + s.id + '\')">' +































      '<b>' + esc(s.name) + '</b><div class="small">' + esc(s.description || '') + ' · ' + s.chars + ' 字</div></div>').join('')































      : '<div class="small">暂无技能</div>') + '</div></div>' +































    '<div class="col"><div class="card" id="skedit"><div class="empty">选择左侧技能进行编辑，或新建</div></div></div></div>';































  setView(v, seq, h);































}































function newSkill(){ editSkill(null); }































async function editSkill(sid){































  const s = sid ? await api('/api/skills/' + sid) : {id:'', meta:{name:'', description:''}, body:''};































  if(!$('skedit')) return;































  $('skedit').innerHTML = '<b style="font-size:15px">' + (sid ? '编辑技能' : '新建技能') + '</b>' +































    '<div class="flex" style="margin-top:12px"><div class="col field"><label>标识（英文，引用时用）</label>' +































    '<input id="s_id" value="' + esc(sid || '') + '" ' + (sid ? 'disabled' : '') + ' placeholder="bid_writing"></div>' +































    '<div class="col field"><label>名称</label><input id="s_name" value="' + esc((s.meta || {}).name || '') + '"></div></div>' +































    '<div class="field"><label>说明</label><input id="s_desc" value="' + esc((s.meta || {}).description || '') + '"></div>' +































    '<div class="field"><label>正文（写给模型看的作业规范，支持 Markdown）</label>' +































    '<textarea id="s_body" style="min-height:320px;font-family:ui-monospace,Consolas,monospace">' +































    esc(s.body || '') + '</textarea></div>' +































    '<div class="row"><button onclick="saveSkill(\'' + (sid || '') + '\')">保存</button>' +































    (sid ? '<button class="danger" onclick="delSkill(\'' + sid + '\')">删除</button>' : '') +































    '<span id="smsg"></span></div>';































}































async function saveSkill(sid){































  const body = {id:(sid || $('s_id').value.trim()), name:$('s_name').value.trim(),































    description:$('s_desc').value.trim(), body:$('s_body').value};































  if(!body.id){ $('smsg').innerHTML = '<span style="color:var(--red)">标识不能为空</span>'; return; }































  try{































    await api('/api/skills', {method:'POST', body:JSON.stringify(body)});































    S.cat = await api('/api/catalog');































    await render();































    msg2('smsg', '已保存');































  }catch(e){ $('smsg').innerHTML = '<span style="color:var(--red)">' + esc(e.message) + '</span>'; }































}































async function delSkill(sid){































  if(!confirm('删除技能「' + sid + '」？引用它的智能体会出现引用告警。')) return;































  await api('/api/skills/' + sid, {method:'DELETE'});































  S.cat = await api('/api/catalog');































  await render();































}































































/* ------------------------------------------------------------ 工具与 MCP */































async function viewTool(v, seq){































  const t = await api('/api/tools');































  const m = await api('/api/mcp/servers');































  let h = '<div class="flex" style="gap:16px;align-items:flex-start"><div class="col">' +































    '<div class="card"><b style="font-size:15px">工具注册中心</b>' +































    '<div class="small" style="margin:4px 0 10px">共 ' + t.total + ' 个：内置 + MCP 接入，智能体按名称引用</div>' +































    '<table><tr><th>名称</th><th>来源</th><th>说明</th><th></th></tr>' +































    t.items.map(x => '<tr><td class="mono">' + esc(x.name) + '</td><td><span class="badge b-src">' +































      esc(x.source) + (x.server ? ' · ' + esc(x.server) : '') + '</span></td><td class="small">' +































      esc(x.description || '') + '</td><td><button class="sm ghost" onclick="tryTool(\'' + x.name + '\')">试调用</button></td></tr>').join('') +































    '</table></div></div>' +































    '<div style="width:420px"><div class="card"><b style="font-size:15px">MCP Server</b>' +































    '<div class="small" style="margin:4px 0 10px">接入后其工具自动进入注册中心，可被任意智能体挂载</div>' +































    m.items.map(s => '<div class="list-item"><div class="row"><b>' + esc(s.name) + '</b>' +































      '<span class="spacer" style="flex:1"></span><span class="badge ' +































      (s.status === 'connected' ? 'b-pub' : 'b-arch') + '">' + esc(s.status || '未连接') + '</span></div>' +































      '<div class="small mono">' + esc(s.transport) + ' ' + esc(s.url || s.command || '') + '</div>' +































      '<div class="row" style="margin-top:6px">' +































      '<button class="sm ghost" onclick="connectMcp(\'' + s.id + '\')">重连</button>' +































      '<button class="sm danger" onclick="delMcp(\'' + s.id + '\')">删除</button>' +































      '<span class="small">' + (toolsCount(s.tools) ? toolsCount(s.tools) + ' 个工具' : '') + '</span></div>' +































      (s.last_error ? '<div class="small" style="color:var(--red)">' + esc(s.last_error) + '</div>' : '') + '</div>').join('') +































    '<div style="margin-top:12px;border-top:1px solid var(--line);padding-top:12px">' +































    '<div class="field"><label>名称</label><input id="m_name" placeholder="知识库"></div>' +































    '<div class="field"><label>传输</label><select id="m_tp"><option value="http">HTTP（Streamable）</option>' +































    '<option value="stdio">stdio（本地命令）</option></select></div>' +































    '<div class="field"><label>URL</label><input id="m_url" placeholder="http://host:8083/mcp"></div>' +































    '<div class="field"><label>请求头 JSON（如 Bearer Token）</label>' +































    '<input id="m_hdr" placeholder="Authorization Bearer Token"></div>' +































    '<div class="row"><button class="sm" onclick="testMcp()">测试连通</button>' +































    '<button class="sm ghost" onclick="saveMcp()">保存并接入</button></div>' +































    '<div id="mmsg" style="margin-top:8px"></div></div></div></div></div>';































  setView(v, seq, h);































}































function refresh(){ return render(); }































async function tryTool(name){































  const args = prompt('调用 ' + name + ' 的参数（JSON）：', '{"query":"SLA"}');































  if(args === null) return;































  try{































    const r = await api('/api/tools/test', {method:'POST',































      body:JSON.stringify({name:name, args:JSON.parse(args || '{}')})});































    openModal('<h3>' + esc(name) + ' 调用结果</h3><pre>' + esc(JSON.stringify(r, null, 2)) + '</pre>');































  }catch(e){ alert('调用失败：' + e.message); }































}































async function testMcp(){































  const body = {name:$('m_name').value || '未命名', transport:$('m_tp').value, url:$('m_url').value,































    headers:parseJSON($('m_hdr').value)};































  $('mmsg').innerHTML = '<div class="small">测试中…</div>';































  try{































    const r = await api('/api/mcp/servers/test', {method:'POST', body:JSON.stringify(body)});































    $('mmsg').innerHTML = r.ok ? '<div class="ok">连通：' + (r.tools ? r.tools.length : 0) + ' 个工具</div>'































      : '<div class="err">' + esc(r.error || '失败') + '</div>';































  }catch(e){ $('mmsg').innerHTML = '<div class="err">' + esc(e.message) + '</div>'; }































}































function parseJSON(s){ if(!s || !s.trim()) return {}; try{ return JSON.parse(s); }catch(e){ return {}; } }































// MCP 列表里 tools 可能是已解析的数组，也可能是 JSON 字符串，两种都要能吃































function toolsCount(t){































  if(!t) return 0;































  if(Array.isArray(t)) return t.length;































  try{ return JSON.parse(t).length; }catch(e){ return 0; }































}































async function saveMcp(){































  const body = {name:$('m_name').value || '未命名', transport:$('m_tp').value, url:$('m_url').value,































    headers:parseJSON($('m_hdr').value), enabled:true};































  try{































    await api('/api/mcp/servers', {method:'POST', body:JSON.stringify(body)});































    S.cat = await api('/api/catalog');































    await render();































  }catch(e){ $('mmsg').innerHTML = '<div class="err">' + esc(e.message) + '</div>'; }































}































async function connectMcp(id){































  await api('/api/mcp/servers/' + id + '/connect', {method:'POST'});































  S.cat = await api('/api/catalog'); await render();































}































async function delMcp(id){































  await api('/api/mcp/servers/' + id, {method:'DELETE'});































  S.cat = await api('/api/catalog'); await render();































}































































/* ------------------------------------------------------------ 任务中心 */































async function viewTask(v, seq){































  const d = await api('/api/tasks?limit=60');































  S.tasks = d.items;































  let h = '<div class="flex" style="gap:16px;align-items:flex-start">' +































    '<div style="width:340px"><div class="card"><b>任务列表</b>' + (S.role==='user' ? ' <span class="small" style="font-weight:400">(只读)</span>' : '') +































    '  <div class="task-user-hint">&#x2139; 业务人员视图：只读模式，可查看任务结果与下载产物</div>' +







    (S.role==='builder' ? '<div class="small" style="margin:4px 0 10px">点击查看详情与产物，可续跑未完成任务</div>' :







     '<div class="small" style="margin:4px 0 10px">点击查看任务详情与下载产物</div>') +































    (d.items.length ? d.items.map(t => '<div class="list-item' + (S.curTask === t.id ? ' on' : '') +































      '" onclick="taskDetail(\'' + t.id + '\')"><div class="row"><b>' + esc(t.title || t.agent_id) + '</b>' +































      '<span class="spacer" style="flex:1"></span>' + taskBadge(t.status) + '</div>' +































      '<div class="small">' + esc(t.stage || '') + ' · ' + esc(fmt(t.created_at)) + '</div>' +































      '<div class="bar"><i style="width:' + t.progress + '%"></i></div></div>').join('')































      : '<div class="empty">暂无任务</div>') + '</div></div>' +































    '<div class="col" id="tdetail"><div class="empty">选择左侧任务查看详情</div></div></div>';































  setView(v, seq, h);































  if(S.curTask) await taskDetail(S.curTask);































}































function taskBadge(s){































  const m = {done:'b-pub', failed:'b-arch', running:'b-live', queued:'b-draft',































             interrupted:'b-draft', canceled:'b-arch'};































  const n = {done:'完成', failed:'失败', running:'运行中', queued:'排队', interrupted:'已中断', canceled:'已取消'};































  return '<span class="badge ' + (m[s] || 'b-draft') + '">' + (n[s] || s) + '</span>';































}































function fmt(ts){































  if(!ts) return '';































  const d = new Date(ts * 1000);































  return (d.getMonth() + 1) + '-' + d.getDate() + ' ' + String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');































}































async function taskDetail(tid){































  S.curTask = tid;































  const d = await api('/api/tasks/' + tid);































  const t = d.task;































  let h = '<div class="card"><div class="row"><b style="font-size:15px">' + esc(t.title || '') + '</b>' +































    '<span class="spacer" style="flex:1"></span>' + taskBadge(t.status) + '</div>' +































    '<div class="small" style="margin:6px 0">' + esc(t.stage || '') + ' · 进度 ' + t.progress + '%' +































    ' · Tokens ' + t.tokens_in + '/' + t.tokens_out + '</div>' +































    '<div class="bar"><i style="width:' + t.progress + '%"></i></div>' +































    (t.error ? '<div class="err">' + esc(t.error) + '</div>' : '') +































    '<div class="row" style="margin-top:10px">' +































    (['interrupted','failed','canceled'].indexOf(t.status) >= 0 ? '<button class="sm task-actions-builder" onclick="retryTask(\'' + tid + '\')">' + (t.status==='interrupted' ? '恢复任务' : '重跑失败项') + '</button>' : '') +
    ((t.status==='running' || t.status==='queued') ? '<button class="sm task-actions-builder" onclick="cancelTask(\'' + tid + '\')">取消</button>' : '') +































    '<button class="sm ghost" onclick="taskDetail(\'' + tid + '\')">刷新</button></div></div>';































  if(d.units && d.units.length){































    h += '<div class="card"><b>执行单元</b><div class="small" style="margin:4px 0 8px">' +































      '已完成 ' + d.units.filter(u => u.status === 'done').length + '/' + d.units.length + '，续跑=只重跑未完成/失败单元，已完成的会直接复用</div>' +































      '<table><tr><th>#</th><th>单元</th><th>状态</th><th>重试</th></tr>' +































      d.units.map(u => '<tr><td>' + u.seq + '</td><td>' + esc(u.title || u.unit_key) + '</td><td>' + esc(u.status) +































        '</td><td>' + u.attempt + '</td></tr>').join('') + '</table></div>';































  }































  if(d.answer) h += '<div class="card"><b>输出</b><pre>' + esc(d.answer) + '</pre></div>';































  if(d.numbers && d.numbers.length) h += '<div class="card"><b>数字台账</b>' +































    '<table><tr><th>项</th><th>值</th><th>单位</th><th>来源</th></tr>' +































    d.numbers.map(n => '<tr><td>' + esc(n.key) + '</td><td>' + esc(n.value) + '</td><td>' + esc(n.unit || '') +































      '</td><td class="small">' + esc(n.source || '') + '</td></tr>').join('') + '</table></div>';































  if(d.tool_calls && d.tool_calls.length) h += '<div class="card"><b>工具调用</b>' +































    '<table><tr><th>工具</th><th>来源</th><th>结果</th><th>耗时</th></tr>' +































    d.tool_calls.map(c => '<tr><td>' + esc(c.tool) + '</td><td>' + esc(c.source) + '</td><td>' +































      (c.ok ? '成功' : '失败') + '</td><td>' + c.ms + 'ms</td></tr>').join('') + '</table></div>';































  if(d.artifacts && d.artifacts.length) h += '<div class="card"><b>产物</b>' +































    d.artifacts.map(a => '<div class="kv"><span>' + esc(a.name) + ' <span class="small">' +































      Math.round(a.size / 1024) + ' KB</span></span><button class="sm" onclick="dl(\'' + a.id + '\')">下载</button></div>').join('') +































    '</div>';































  const el = $('tdetail');































  if(el) el.innerHTML = h;































}































async function retryTask(tid){ await api('/api/tasks/' + tid + '/retry', {method:'POST'}); taskDetail(tid); }
async function cancelTask(tid){ await api('/api/tasks/' + tid + '/cancel', {method:'POST'}); taskDetail(tid); }































































/* ------------------------------------------------------------ 弹窗 / 设置 */































function openModal(html){ $('modal').innerHTML = html; $('mask').classList.add('on'); }































function closeModal(){ $('mask').classList.remove('on'); }































$('mask').onclick = e => { if(e.target.id === 'mask') closeModal(); };































































/* ------------------------------------------------- 模型目录（可搜索下拉） */































const MP = {items: [], loaded: false, info: ''};































































async function loadModels(force){































  const d = await api('/api/llm/models' + (force ? '?force=1' : ''));































  MP.items = d.items || []; MP.loaded = true; MP.info = d;































  return d;































}































function priceLabel(m){































  if(m.dyn) return '动态定价';































  if(m.free) return '免费';































  const a = (m.pin === 0 || m.pin) ? m.pin : '?';































  const b = (m.pout === 0 || m.pout) ? m.pout : '?';































  return '$' + a + '/$' + b + ' 每百万token';































}































function modelOptions(value, items, placeholder){































  let h = placeholder ? '<option value="">' + esc(placeholder) + '</option>' : '';































  let g = null;































  for(const m of items){































    if(m.group !== g){































      if(g !== null) h += '</optgroup>';































      g = m.group; h += '<optgroup label="' + esc(g) + '">';































    }































    h += '<option value="' + esc(m.id) + '"' + (m.id === value ? ' selected' : '') + '>'































       + esc(m.name) + '　·　' + esc(m.id) + '　·　' + esc(priceLabel(m))































       + (m.tools ? '' : '　·　不支持工具') + '</option>';































  }































  if(g !== null) h += '</optgroup>';































  return h;































}































function matchModels(kw){































  const k = (kw || '').trim().toLowerCase();































  if(!k) return MP.items;































  return MP.items.filter(m =>































    m.id.toLowerCase().includes(k) ||































    (m.name || '').toLowerCase().includes(k) ||































    (m.group || '').toLowerCase().includes(k));































}































/* 通用模型选择字段：pfx 前缀，label 标题，value 当前值，ph 空值占位文案 */































function modelField(pfx, label, value, ph, tip){































  return '<div class="field"><label>' + esc(label) + '</label>' +































    '<input id="' + pfx + '_q" placeholder="搜索模型：gpt / claude / deepseek / qwen / free" ' +































      'oninput="filterModel(\'' + pfx + '\')" style="margin-bottom:6px">' +































    '<select id="' + pfx + '_sel" onchange="onModelPick(\'' + pfx + '\')"></select>' +































    '<div class="small" id="' + pfx + '_info" style="margin-top:4px">' + (tip ? esc(tip) : '') + '</div></div>';































}































function filterModel(pfx){































  const sel = $(pfx + '_sel');































  if(!sel) return;































  const cur = sel.value;































  sel.innerHTML = modelOptions(cur, matchModels($(pfx + '_q').value), window['MP_PH_' + pfx] || '');































  onModelPick(pfx);































}































function onModelPick(pfx){































  const sel = $(pfx + '_sel'), info = $(pfx + '_info');































  if(!sel || !info) return;































  const m = MP.items.find(x => x.id === sel.value);































  info.innerHTML = m































    ? (esc(m.name) + '　上下文 ' + (m.ctx ? (m.ctx / 1024).toFixed(0) + 'K' : '未知')































       + '　价格 ' + esc(priceLabel(m)) + '　工具调用 ' + (m.tools ? '支持' : '不支持'))































    : '<span class="small">未选择</span>';































}































function bindModelField(pfx, value, ph){































  window['MP_PH_' + pfx] = ph || '';































  const sel = $(pfx + '_sel');































  if(!sel) return;































  sel.innerHTML = modelOptions(value, MP.items, ph || '');































  onModelPick(pfx);































}































































async function openSettings(){































  const d = await api('/api/settings');































  const s = d.settings || {};































  openModal('<h3>模型设置</h3>' +































    '<div class="field"><label>API Base URL（OpenRouter / OpenAI 兼容）</label>' +































    '<input id="st_url" value="' + esc(s.llm_base_url || '') + '"></div>' +































    '<div class="field"><label>API Key</label><input id="st_key" placeholder="sk-or-v1-..." value="' +































      esc(s.llm_api_key || '') + '"></div>' +































    '<div id="st_models"><div class="small">正在加载可用模型…</div></div>' +































    '<div class="row"><button onclick="saveSettings()">保存</button>' +































    '<button class="ghost" onclick="refreshModels()">刷新模型列表</button>' +































    '<button class="ghost" onclick="testLLM()">测试连通</button>' +































    '<button class="ghost" onclick="testCurModel()">测试选中模型</button>' +































    '<button class="ghost" onclick="closeModal()">关闭</button></div>' +































    '<div id="stmsg" style="margin-top:10px"></div>');































  await refreshModels(false, s.llm_model || '', s.llm_model_strong || '');































}































async function refreshModels(force, cur, strong){































  const box = $('st_models');































  if(box) box.innerHTML = '<div class="small">' + (force ? '正在重新拉取模型列表…' : '正在加载可用模型…') + '</div>';































  let d;































  try{ d = await loadModels(!!force); }































  catch(e){































    if(box) box.innerHTML = '<div class="err">模型列表加载失败：' + esc(e.message) + '</div>';































    return;































  }































  if(!box) return;































  const tip = d.configured































    ? ('共 ' + d.total + ' 个模型可用' + (d.source === 'preset' ? '（内置推荐，未取到远端列表）' : '') + (d.error ? '　' + esc(d.error) : ''))































    : '尚未配置 API Key，当前为内置推荐模型。填写 Key 并保存后自动拉取完整列表。';































  box.innerHTML =































    (d.error ? '<div class="err" style="margin-bottom:8px">' + esc(d.error) + '</div>' : '') +































    '<div class="small" style="margin-bottom:8px">' + esc(tip) + '</div>' +































    modelField('st_m', '默认模型（对话 / 常规任务）', cur || '', '') +































    modelField('st_ms', '强模型（长文档 / 复杂推理，留空同默认）', strong || '', '（跟随默认模型）');































  bindModelField('st_m', cur || '', '');































  bindModelField('st_ms', strong || '', '（跟随默认模型）');































}































async function saveSettings(){































  const body = {llm_base_url:$('st_url').value, llm_api_key:$('st_key').value,































                llm_model:$('st_m_sel').value, llm_model_strong:$('st_ms_sel').value};































  await api('/api/settings', {method:'POST', body:JSON.stringify(body)});































  $('stmsg').innerHTML = '<div class="ok">已保存</div>';































  health();































  if(body.llm_api_key && !body.llm_api_key.includes('...')){































    $('stmsg').innerHTML = '<div class="ok">已保存，正在拉取该 Key 可用的模型…</div>';































    await refreshModels(true, body.llm_model, body.llm_model_strong);































    $('stmsg').innerHTML = '<div class="ok">已保存，已加载 ' + MP.items.length + ' 个可用模型</div>';































  }































}































async function testLLM(){































  const r = await api('/api/llm/test', {method:'POST'});































  $('stmsg').innerHTML = r.ok ? '<div class="ok">' + (r.mocked ? '当前为模拟模式' : ('连通成功 · ' + esc(r.reply || ''))) + '</div>'































    : '<div class="err">' + esc(r.error || '') + '</div>';































}































async function testCurModel(){































  const mid = $('st_m_sel').value;































  $('stmsg').innerHTML = '<div class="small">正在用 ' + esc(mid) + ' 发一次测试请求…</div>';































  const r = await api('/api/llm/test-model', {method:'POST', body:JSON.stringify({model:mid})});































  $('stmsg').innerHTML = r.ok































    ? '<div class="ok">可用 · ' + esc(r.model) + ' · ' + r.ms + 'ms · 回复：' + esc(r.reply || '') + '</div>'































    : '<div class="err">不可用：' + esc(r.error || '') + '</div>';































}































































/* ------------------------------------------------------------ 启动 */































async function health(){































  try{































    const h = await api('/api/health');































    const m = $('mode');































    m.className = 'badge ' + (h.mocked ? 'b-mock' : 'b-live');































    m.textContent = h.mocked ? '模拟模式（未接入模型）' : '已接入 ' + h.model;































  }catch(e){ $('mode').textContent = '离线'; }































}































async function stats(){































  try{































    const s = await api('/api/stats');































    $('stats').textContent = '<b>' + s.published_agents + '</b> 发布 · ' + s.tasks + ' 任务 · ' + s.artifacts + ' 产物';































  }catch(e){}































}































renderTabs(); render(); health(); stats();































api('/api/catalog').then(c => { S.cat = c; }).catch(() => {});































setInterval(() => { if(S.tab === 'task' && S.curTask) taskDetail(S.curTask); }, 3000);































setInterval(health, 15000);































































/* ==================== 运行监控（Langfuse 风格可观测性） ==================== */















function fmtNum(n){ n=n||0; if(n>=1e6) return (n/1e6).toFixed(2)+'M'; if(n>=1e3) return (n/1e3).toFixed(1)+'k'; return n; }































function renderDailyChart(items){















  const arr = (items||[]).slice().reverse();















  if(!arr.length) return '<div class="card"><div class="card-h">近 14 天趋势</div><div class="empty">暂无数据</div></div>';















  const W=920, H=170, pad=26, slot=(W-pad*2)/arr.length, bw=Math.max(6, slot-6);















  const maxN = Math.max(1, ...arr.map(x=>x.n));















  const maxT = Math.max(1, ...arr.map(x=>(x.ti||0)+(x.to_||0)));















  let bars='', labels='';















  arr.forEach((x,i)=>{















    const x0 = pad + i*slot + 3;















    const hN = (x.n/maxN)*(H-pad*2);















    const hT = ((x.ti+x.to_)/maxT)*(H-pad*2);















    bars += '<rect x="'+x0+'" y="'+(H-pad-hN)+'" width="'+bw+'" height="'+hN+'" rx="2" fill="var(--green)" opacity=".85"/>';















    bars += '<rect x="'+x0+'" y="'+(H-pad-hT)+'" width="'+bw+'" height="'+hT+'" rx="2" fill="var(--blue)" opacity=".30"/>';















    labels += '<text x="'+(x0+bw/2)+'" y="'+(H-7)+'" fill="var(--dim)" font-size="9" text-anchor="middle">'+((x.d||'').slice(5))+'</text>';















  });















  return '<div class="card"><div class="card-h">近 14 天趋势 <span class="small">（绿=调用次数，蓝=Token 量）</span></div>'+















         '<svg viewBox="0 0 '+W+' '+H+'" style="width:100%;height:auto">'+















         '<line x1="'+pad+'" y1="'+(H-pad)+'" x2="'+(W-pad)+'" y2="'+(H-pad)+'" stroke="var(--line)"/>'+















         bars+labels+'</svg></div>';















}































function renderModelBars(items){















  if(!items || !items.length) return '<div class="empty">暂无数据</div>';















  const max = Math.max(1, ...items.map(x=>x.n));















  return items.map(m=>{















    const w = Math.round(m.n/max*100);















    return '<div class="mbar"><div class="mb-label"><span>'+esc(m.model||'?')+'</span>'+















           '<span class="small">'+m.n+' 次 · '+fmtNum(m.ti+m.to_)+' tok · $'+m.cost_usd.toFixed(3)+'</span></div>'+















           '<div class="mb-track"><i style="width:'+w+'%"></i></div></div>';















  }).join('');















}































async function viewMonitor(v, seq){















  let ov,daily,models,agents,traces;















  try{















    [ov,daily,models,agents,traces] = await Promise.all([















      api('/api/monitor/overview'),















      api('/api/monitor/daily?days=14'),















      api('/api/monitor/models'),















      api('/api/monitor/agents'),















      api('/api/monitor/traces?limit=30')















    ]);















  }catch(e){















    if(seq===renderSeq) v.innerHTML='<div class="err">监控数据加载失败：'+esc(e.message)+'</div>';















    return;















  }















  const cards = [















    {l:'LLM 调用', v:ov.calls, s:'次'},















    {l:'Token 总量', v:fmtNum(ov.tokens_total), s:''},















    {l:'预估成本', v:'$'+ov.cost_usd.toFixed(3), s:''},















    {l:'平均延迟', v:ov.avg_latency_ms, s:'ms'}, {l:'P95延迟', v:ov.p95_latency_ms, s:'ms'}, {l:'P99延迟', v:ov.p99_latency_ms, s:'ms'},















    {l:'错误率', v:(ov.error_rate*100).toFixed(1), s:'%'},















    {l:'活跃智能体', v:ov.active_agents, s:'个'},















    {l:'会话数', v:ov.sessions, s:''},















    {l:'模拟占比', v:(ov.mocked_rate*100).toFixed(0), s:'%'}, {l:'工具失败', v:ov.tool_calls_failed + '/' + ov.tool_calls_total, s:''},















  ];















  let h = '<div class="mon-head"><b>运行监控</b><span class="small">Langfuse 风格可观测性 · 覆盖对话与任务型智能体的 LLM 调用、成本、延迟与质量</span></div>';















  h += '<div class="mon-cards">'+cards.map(c=>















    '<div class="mon-card"><div class="mc-v">'+c.v+'<span class="mc-u">'+c.s+'</span></div><div class="mc-l">'+c.l+'</div></div>'















  ).join('')+'</div>';















  h += renderDailyChart(daily.items);















  h += '<div class="mon-2col">';















  h += '<div class="card"><div class="card-h">模型分布</div>'+renderModelBars(models.items)+'</div>';















  h += '<div class="card"><div class="card-h">智能体调用排行</div>'+















       '<table><tr><th>智能体</th><th>调用</th><th>Token</th><th>延迟</th><th>错误</th></tr>'+















       (agents.items||[]).map(a=>'<tr><td>'+esc(a.name)+'</td><td>'+a.n+'</td><td>'+fmtNum(a.ti+a.to_)+'</td><td>'+Math.round(a.lat)+'ms</td><td>'+















         (a.errn?('<span class="badge b-err">'+a.errn+'</span>'):'0')+'</td></tr>').join('')+'</table></div>';















  h += '</div>';















  h += '<div class="card"><div class="card-h">最近调用（Trace）</div>'+















       '<table><tr><th>时间</th><th>会话</th><th>智能体</th><th>模型</th><th>Token(in/out)</th><th>延迟</th><th>状态</th></tr>'+















       (traces.items||[]).map(t=>{















         const st = t.err ? '<span class="badge b-err">错误</span>' : (t.mocked ? '<span class="badge b-mock">模拟</span>' : '<span class="badge b-ok">成功</span>');















         return '<tr><td class="small">'+fmtTime(t.ts)+'</td><td>'+esc(t.session_title||'')+'</td><td>'+esc(t.agent_name||'')+'</td><td class="small">'+esc(t.model||'')+'</td><td>'+t.ti+'/'+t.to_+'</td><td>'+Math.round(t.lat)+'ms</td><td>'+st+'</td></tr>';















       }).join('')+'</table></div>';















  if(seq===renderSeq) v.innerHTML = h;















}















</script>































</body>































</html>































