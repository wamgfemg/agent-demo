<!DOCTYPE html>































<html lang="zh-CN">































<head>































<meta charset="utf-8">































<meta name="viewport" content="width=device-width,initial-scale=1">































<title>AgentForge · 智能体开发管理平台</title>































<style>































:root{































  --bg:#0e1512; --panel:#141d19; --panel2:#182420; --line:#24332c;































  --text:#dfeae4; --dim:#8ca79b; --green:#22c55e; --green2:#16a34a;































  --amber:#f59e0b; --red:#ef4444; --blue:#38bdf8;































}































*{box-sizing:border-box}































body{margin:0;background:var(--bg);color:var(--text);font:14px/1.6 -apple-system,"Segoe UI","Microsoft YaHei",sans-serif}































button{background:var(--green2);color:#fff;border:0;padding:7px 14px;border-radius:6px;cursor:pointer;font-size:13px}































button:hover{background:var(--green)}































button.ghost{background:transparent;border:1px solid var(--line);color:var(--text)}































button.ghost:hover{border-color:var(--green);color:var(--green)}































button.sm{padding:4px 9px;font-size:12px}































button.danger{background:transparent;border:1px solid var(--red);color:var(--red)}































button.danger:hover{background:var(--red);color:#fff}































input,select,textarea{background:#0c1310;border:1px solid var(--line);color:var(--text);































  border-radius:6px;padding:8px 10px;width:100%;font:13px inherit;outline:none}































input:focus,textarea:focus,select:focus{border-color:var(--green)}































textarea{min-height:80px;resize:vertical;font-family:inherit}































label{display:block;margin:0 0 5px;color:var(--dim);font-size:12px}































header{display:flex;align-items:center;gap:12px;padding:12px 20px;background:var(--panel);































  border-bottom:1px solid var(--line);position:sticky;top:0;z-index:30}































.logo{font-size:17px;font-weight:700;color:var(--green);letter-spacing:.5px}































.tabs{display:flex;gap:4px;margin-left:8px}































.tab{padding:7px 14px;border-radius:6px;cursor:pointer;color:var(--dim);font-size:13px;border:1px solid transparent}































.tab:hover{color:var(--text)}































.tab.on{background:var(--panel2);color:var(--green);border-color:var(--line)}































.spacer{flex:1}































.badge{padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600}































.b-live{background:rgba(34,197,94,.16);color:var(--green)}































.b-mock{background:rgba(245,158,11,.16);color:var(--amber)}































.b-draft{background:rgba(245,158,11,.14);color:var(--amber)}































.b-pub{background:rgba(34,197,94,.14);color:var(--green)}































.b-arch{background:rgba(140,167,155,.14);color:var(--dim)}































.b-src{background:rgba(56,189,248,.14);color:var(--blue);font-weight:400}































.wrap{max-width:1500px;margin:0 auto;padding:18px 20px 60px}































.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px;margin-bottom:14px}































.grid{display:grid;gap:12px}































.g4{grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}































.g2{grid-template-columns:1fr 1fr}































.agent-card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px;































  cursor:pointer;transition:.15s}































.agent-card:hover{border-color:var(--green);transform:translateY(-2px)}































.ac-top{display:flex;gap:10px;align-items:center;margin-bottom:8px}































.ac-icon{font-size:26px}































.ac-name{font-weight:600;font-size:15px}































.ac-desc{color:var(--dim);font-size:12px;min-height:36px;margin-bottom:10px}































.ac-meta{display:flex;gap:6px;flex-wrap:wrap;font-size:11px}































.row{display:flex;gap:10px;align-items:center}































.small{font-size:12px;color:var(--dim)}































.mono{font-family:ui-monospace,Consolas,monospace;font-size:12px}































pre{background:#0a110e;border:1px solid var(--line);border-radius:8px;padding:12px;































  overflow:auto;max-height:420px;white-space:pre-wrap;word-break:break-word;font-size:12.5px}































.bar{height:6px;background:#0a110e;border-radius:3px;overflow:hidden;margin:6px 0}































.bar>i{display:block;height:100%;background:var(--green);transition:width .4s}































.list-item{padding:10px 12px;border:1px solid var(--line);border-radius:8px;margin-bottom:6px;cursor:pointer;background:var(--panel2)}































.list-item:hover{border-color:var(--green)}































.list-item.on{border-color:var(--green);background:rgba(34,197,94,.07)}































.chk{display:flex;gap:8px;align-items:flex-start;padding:7px 9px;border:1px solid var(--line);































  border-radius:7px;margin-bottom:5px;cursor:pointer;background:var(--panel2)}































.chk.on{border-color:var(--green);background:rgba(34,197,94,.07)}































.chk input{margin-top:3px;width:auto}































.mask{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;































  justify-content:center;z-index:60;padding:24px}































.mask.on{display:flex}































.modal{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px;































  width:min(980px,100%);max-height:88vh;overflow:auto}































.modal h3{margin:0 0 14px;font-size:16px}































.flex{display:flex;gap:12px}































.col{flex:1;min-width:0}































.kv{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dashed var(--line);font-size:12.5px}































.rt{border:1px solid var(--line);border-radius:8px;padding:10px;margin-bottom:7px;cursor:pointer;background:var(--panel2)}































.rt.on{border-color:var(--green);background:rgba(34,197,94,.08)}































.rt b{font-size:13px}































.rt div{font-size:11.5px;color:var(--dim);margin-top:3px}































.warn{background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.3);color:var(--amber);































  padding:8px 12px;border-radius:7px;font-size:12.5px;margin-bottom:10px}































.err{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);color:#fca5a5;































  padding:8px 12px;border-radius:7px;font-size:12.5px;margin-bottom:10px}































.ok{background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);color:#86efac;































  padding:8px 12px;border-radius:7px;font-size:12.5px;margin-bottom:10px}































table{width:100%;border-collapse:collapse;font-size:12.5px}































th,td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left}































th{color:var(--dim);font-weight:500}































.empty{padding:40px;text-align:center;color:var(--dim)}































.field{margin-bottom:12px}































.chips{display:flex;flex-wrap:wrap;gap:5px}































.chip{padding:2px 8px;border-radius:20px;background:var(--panel2);border:1px solid var(--line);font-size:11px}































.pill{padding:2px 8px;border-radius:5px;font-size:11px;background:var(--panel2);border:1px solid var(--line)}















































/* ==================== 聊天对话框样式 ==================== */















.chat-modal{display:flex;flex-direction:column;width:min(980px,100%);height:85vh;max-height:85vh;















  background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden}















.chat-header{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line);















  background:var(--panel2);flex-shrink:0}















.chat-header .ch-title{font-weight:600;font-size:15px;flex:1}















.chat-header .ch-actions{display:flex;gap:6px}















.chat-body{display:flex;flex:1;min-height:0}















.chat-sidebar{width:200px;border-right:1px solid var(--line);background:var(--bg);















  overflow-y:auto;flex-shrink:0}















.chat-sidebar-h{padding:10px 12px;font-size:11px;color:var(--dim);font-weight:600;















  text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid var(--line)}















.chat-conv-item{padding:10px 12px;cursor:pointer;border-bottom:1px solid var(--line);font-size:12.5px;















  transition:.1s}















.chat-conv-item:hover{background:var(--panel2)}















.chat-conv-item.on{background:rgba(34,197,94,.1);border-left:3px solid var(--green)}















.chat-conv-item .cc-title{font-weight:500;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}















.chat-conv-item .cc-time{color:var(--dim);font-size:11px}















.chat-main{flex:1;display:flex;flex-direction:column;min-width:0}















.chat-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px}















.chat-msg{max-width:80%;padding:10px 14px;border-radius:12px;font-size:13.5px;line-height:1.7;















  word-break:break-word;white-space:pre-wrap}















.chat-msg.user{align-self:flex-end;background:var(--green2);color:#fff;border-bottom-right-radius:4px}















.chat-msg.assistant{align-self:flex-start;background:var(--panel2);border:1px solid var(--line);















  border-bottom-left-radius:4px}















.chat-msg .cm-meta{font-size:11px;color:var(--dim);margin-top:4px;display:flex;gap:8px}















.chat-msg.error{border-color:var(--red);background:rgba(239,68,68,.08)}















.chat-input-area{padding:14px 16px;border-top:1px solid var(--line);flex-shrink:0}















.chat-input-wrap{display:flex;gap:8px;align-items:flex-end}















.chat-input{flex:1;background:#0c1310;border:1px solid var(--line);color:var(--text);















  border-radius:10px;padding:10px 14px;font:14px/1.6 inherit;resize:none;min-height:44px;max-height:120px;outline:none}















.chat-input:focus{border-color:var(--green)}















.chat-send{background:var(--green2);color:#fff;border:0;padding:10px 18px;border-radius:10px;















  cursor:pointer;font-size:13px;font-weight:500;white-space:nowrap;flex-shrink:0;height:44px}















.chat-send:hover{background:var(--green)}















.chat-send:disabled{opacity:.5;cursor:not-allowed}















.chat-empty{flex:1;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:13px}















.chat-typing{font-size:12px;color:var(--dim);padding:4px 16px 0;display:flex;gap:4px;align-items:center}















.chat-typing span{width:6px;height:6px;background:var(--dim);border-radius:50%;animation:bounce .6s infinite alternate}















.chat-typing span:nth-child(2){animation-delay:.15s}















.chat-typing span:nth-child(3){animation-delay:.3s}















@keyframes bounce{to{transform:translateY(-4px)}}















.ch-avatar{width:34px;height:34px;display:flex;align-items:center;justify-content:center;















  font-size:20px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;flex-shrink:0}















.ch-sub{font-weight:400;color:var(--dim);font-size:12.5px;margin-left:6px}















.chat-conv-empty{padding:18px 14px;font-size:12px;color:var(--dim);line-height:1.6;text-align:center}















.chat-send svg{display:block}















.chat-send{display:flex;align-items:center;justify-content:center;width:44px;padding:0}















.chat-conv-item.on .cc-title{color:var(--green)}















.chat-msg.user{box-shadow:0 1px 2px rgba(0,0,0,.25)}















.chat-msg.assistant{box-shadow:0 1px 2px rgba(0,0,0,.18)}















.chat-messages{background:linear-gradient(180deg,var(--bg),var(--panel))}































































/* ==================== 角色视图区分 ==================== */















.view-switch{display:flex;background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:3px;gap:3px;margin-right:14px}















.view-switch button{border:0;background:transparent;color:var(--dim);padding:6px 14px;border-radius:7px;cursor:pointer;font-size:13px;font-weight:500;display:flex;align-items:center;gap:5px;transition:.12s}















.view-switch button.on{background:var(--accent);color:#0b0f0d;font-weight:600}















.view-switch button:not(.on):hover{color:var(--text)}















body.role-builder{--accent:#22c55e}















body.role-user{--accent:#38bdf8}















body.role-builder header{border-bottom:2px solid rgba(34,197,94,.45)}















body.role-user header{border-bottom:2px solid rgba(56,189,248,.45)}















.tab.builder-only::after{content:'构建';font-size:9px;background:rgba(34,197,94,.18);color:var(--green);padding:1px 5px;border-radius:4px;margin-left:7px;vertical-align:middle;font-weight:500}















.role-banner{display:flex;align-items:center;gap:8px;padding:8px 16px;font-size:12.5px;border-bottom:1px solid var(--line)}















body.role-builder .role-banner{background:rgba(34,197,94,.08);color:var(--green)}















body.role-user .role-banner{background:rgba(56,189,248,.08);color:var(--blue)}















.role-banner b{font-weight:600}















/* ==================== 运行监控（Langfuse 风格） ==================== */















.mon-head{display:flex;align-items:baseline;gap:10px;margin-bottom:14px;flex-wrap:wrap}















.mon-head b{font-size:17px}















.mon-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:16px}















.mon-card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px 16px}















.mon-card .mc-v{font-size:24px;font-weight:700;color:var(--text)}















.mon-card .mc-u{font-size:12px;color:var(--dim);margin-left:3px;font-weight:400}















.mon-card .mc-l{font-size:12px;color:var(--dim);margin-top:4px}















.mon-2col{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0}















.card-h{font-weight:600;margin-bottom:10px;font-size:14px}















.badge.b-ok{background:rgba(34,197,94,.15);color:#86efac;border:1px solid rgba(34,197,94,.3);padding:1px 7px;border-radius:5px;font-size:11px}















.badge.b-err{background:rgba(239,68,68,.15);color:#fca5a5;border:1px solid rgba(239,68,68,.3);padding:1px 7px;border-radius:5px;font-size:11px}















.mbar{margin-bottom:9px}















.mb-label{display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px}















.mb-track{height:8px;background:var(--panel2);border-radius:5px;overflow:hidden}















.mb-track i{display:block;height:100%;background:linear-gradient(90deg,var(--green2),var(--green));border-radius:5px}















@media(max-width:760px){.mon-2col{grid-template-columns:1fr}}







































/* ==================== Header 右侧权限隔离 ==================== */







.header-right{display:flex;align-items:center;gap:10px}







.header-right .divider{width:1px;height:18px;background:var(--line);flex-shrink:0}







/* 业务人员视图：隐藏所有创建者专属元素 */







body.role-user #mode,







body.role-user #stats,







body.role-user .builder-only-header{display:none !important}







/* 创建者右侧信息组 */







.builder-info{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--dim)}







.builder-info .badge{font-size:11px;padding:2px 8px}















/* ==================== 任务中心角色区分 ==================== */







.task-user-hint{background:rgba(56,189,248,.08);border:1px solid rgba(56,189,248,.25);







  border-radius:8px;padding:10px 14px;font-size:12.5px;color:var(--blue);margin-bottom:14px;







  display:flex;align-items:center;gap:8px}







body.role-builder .task-user-hint{display:none}







.task-actions-builder button{display:inline-block}







body.role-user .task-actions-builder{display:none}















</style>































</head>































<body>































<header>































  <span class="logo">AgentForge</span>































  <div class="view-switch" id="viewSwitch"></div>















  <div class="tabs" id="tabs"></div>































  <div class="spacer"></div>































  <div class="header-right">







    <div class="builder-only-header">







      <span class="badge b-mock" id="mode">检测中</span>







      <span class="builder-info"><span id="stats"></span></span>







      <button class="ghost sm" onclick="openSettings()">设置</button>







    </div>







  </div>















</header>















<div class="role-banner" id="roleBanner"></div>































































<div class="wrap">































  <div id="view"></div>































</div>































































<div class="mask" id="mask"><div class="modal" id="modal"></div></div>































































<script>































const $ = id => document.getElementById(id);































let S = {tab:'work', role:'builder', agents:[], published:[], cat:null, cur:null,































         editing:null, curTask:null, timer:null, tasks:[]};































































const TABS = [































  {id:'work',  name:'工作台',       roles:['builder','user']},































  {id:'build', name:'智能体构建',   roles:['builder']},































  {id:'skill', name:'技能库',       roles:['builder']},































  {id:'tool',  name:'工具与 MCP',   roles:['builder']},
  {id:'engine', name:'执行引擎',     roles:['builder']},































  {id:'task',  name:'任务中心',     roles:['builder','user']},















  {id:'monitor', name:'运行监控',   roles:['builder']}































];































































const API_TOKEN = "af_t0k3n_9f2a7c4e1b8d6a3f5c0e2b9d7a4f1c8";



async function api(u, o){































  o = o || {};

  const h = Object.assign({'Content-Type':'application/json'}, o.headers || {});

  h['Authorization'] = 'Bearer ' + API_TOKEN;

  o.headers = h;

  const r = await fetch(u, o);































  const t = await r.text();































  if(!r.ok){ let m = t; try{ m = JSON.parse(t).detail || t; }catch(e){} throw new Error(String(m).slice(0,300)); }































  try{ return JSON.parse(t); }catch(e){ return t; }































}































const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c =>































  ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));































































/* ------------------------------------------------------------ 导航 */































function setRole(r){















  if(S.role === r) return;















  S.role = r;















  if(r === 'user' && ['work','task','monitor'].indexOf(S.tab) < 0) S.tab = 'work';















  renderTabs(); render();















}































function renderTabs(){















  const vs = $('viewSwitch');















  if(vs){















    vs.innerHTML =















      '<button class="' + (S.role==='builder'?'on':'') + '" onclick="setRole(\'builder\')">🛠 创建者</button>' +















      '<button class="' + (S.role==='user'?'on':'') + '" onclick="setRole(\'user\')">👔 业务人员</button>';















  }















  let h = TABS.filter(t => t.roles.indexOf(S.role) >= 0).map(t => {















    const onlyB = (t.roles.indexOf('user') < 0);















    return '<div class="tab' + (S.tab===t.id?' on':'') + (onlyB?' builder-only':'') + '" onclick="go(\'' + t.id + '\')">' + t.name + '</div>';















  }).join('');















  $('tabs').innerHTML = h;















  const rb = $('roleBanner');















  if(rb){















    if(S.role === 'builder'){















      rb.innerHTML = '🛠 <b>创建者视图</b> · 管理智能体 / 技能 / 工具与 MCP，并查看运行监控';















    }else{















      rb.innerHTML = '👔 <b>业务人员视图</b> · 使用已发布智能体进行对话与任务执行';















    }















  }















  document.body.className = 'role-' + S.role;















  /* 权限隔离：业务人员隐藏创建者专属 UI */







  const isBuilder = (S.role === 'builder');







  document.querySelectorAll('.builder-only-header').forEach(el => {







    el.style.display = isBuilder ? '' : 'none';







  });







}































function switchRole(){































  S.role = S.role === 'builder' ? 'user' : 'builder';































  if(S.role === 'user' && ['work','task'].indexOf(S.tab) < 0) S.tab = 'work';































  renderTabs(); render();































}































function go(t){ S.tab = t; stopPoll(); renderTabs(); render(); }































function stopPoll(){ if(S.timer){ clearInterval(S.timer); S.timer = null; } }































































// 渲染序号：并发 render（快速切 Tab）时，只有最新一次能写入，避免旧结果覆盖新结果































let renderSeq = 0;































function setView(v, seq, html){































  if(seq === renderSeq && v) v.innerHTML = html;































}































async function render(){































  const seq = ++renderSeq;































  const v = $('view');































  try{































    if(S.tab === 'work')  await viewWork(v, seq);































    if(S.tab === 'build') await viewBuild(v, seq);































    if(S.tab === 'skill') await viewSkill(v, seq);































    if(S.tab === 'tool')  await viewTool(v, seq);
    if(S.tab === 'engine') await viewEngine(v, seq);































    if(S.tab === 'task')  await viewTask(v, seq);















    if(S.tab === 'monitor') await viewMonitor(v, seq);































  }catch(e){































    if(seq === renderSeq) v.innerHTML = '<div class="err">加载失败：' + esc(e.message) + '</div>';































  }































}































































/* ------------------------------------------------------------ 工作台 */































async function viewWork(v, seq){































  const d = await api('/api/agents?scope=published');































  S.published = d.items.filter(a => a.enabled !== 0);































  let h = '<div class="card"><div class="row"><b style="font-size:15px">业务工作台</b>' +































        '<span class="small">仅显示已发布且已启用的智能体 · 共 ' + S.published.length + ' 个</span></div>' +































        '<div class="small" style="margin-top:6px">选择智能体，以对话框方式交互，支持多轮对话与历史记录</div></div>';































  if(!S.published.length){































    h += '<div class="empty">还没有已发布的智能体。<br>切换到「构建者视图 - 智能体构建」，配置完成后点击发布。</div>';































  }else{































    h += '<div class="grid g4">' + S.published.map(a =>































      '<div class="agent-card" onclick="openRun(\'' + a.id + '\')">' +































      '<div class="ac-top"><span class="ac-icon">' + esc(a.icon || '?') + '</span>' +































      '<div><div class="ac-name">' + esc(a.name) + '</div>' +































      '<div class="small">' + esc(a.category || '') + '</div></div></div>' +































      '<div class="ac-desc">' + esc(a.description || '') + '</div>' +































      '<div class="ac-meta"><span class="badge b-pub">v' + a.version + '</span>' +































      '<span class="pill">' + esc(rtName(a.runtime)) + '</span>' +































      (a.skills.length ? '<span class="pill">技能 ' + a.skills.length + '</span>' : '') +































      (a.tools.length ? '<span class="pill">工具 ' + a.tools.length + '</span>' : '') + '</div>' +































      '</div>').join('') + '</div>';































  }































  setView(v, seq, h);































}































function rtName(id){ const r = (S.cat && S.cat.runtimes || []).find(x => x.id === id); return r ? r.name : id; }































































function formHTML(schema, prefix){































  return (schema || []).map(f => {































    const key = prefix + '_' + f.key;































    const lab = esc(f.label || f.key) + (f.required ? ' <span style="color:var(--red)">*</span>' : '');































    if(f.type === 'text') return '<div class="field"><label>' + lab + '</label>' +































      '<input id="' + key + '" placeholder="' + esc(f.placeholder || '') + '"></div>';































    if(f.type === 'number') return '<div class="field"><label>' + lab + '</label>' +































      '<input id="' + key + '" type="number" placeholder="' + esc(f.placeholder || '') + '"></div>';































    return '<div class="field"><label>' + lab + '</label>' +































      '<textarea id="' + key + '" placeholder="' + esc(f.placeholder || '') + '"></textarea></div>';































  }).join('');































}































function readForm(schema, prefix){































  const o = {};































  (schema || []).forEach(f => { const el = $(prefix + '_' + f.key); if(el) o[f.key] = el.value; });































  return o;































}































function checkForm(schema, prefix){































  const miss = (schema || []).filter(f => f.required && !($(prefix + '_' + f.key) && $(prefix + '_' + f.key).value.trim()));































  return miss.map(f => f.label || f.key);































}































































/* ==================== 聊天对话框（类 WorkBuddy 新建任务风格） ==================== */















let CS = {agentId:null, agentName:'', convId:null, messages:[], sending:false, convs:[]};































async function openRun(aid){















  let a = S.published.filter(x => x.id === aid)[0];















  if(!a) a = await api('/api/agents/' + aid);















  CS.agentId = aid;















  CS.agentName = a.name || aid;















  CS.convId = null;















  CS.messages = [];















  openChatModal(a);















}































function openChatModal(agent){















  const html =















    '<div class="chat-header">' +















      '<span class="ch-avatar">' + (agent.icon || '\u{1F916}') + '</span>' +















      '<span class="ch-title">' + esc(agent.name || '') +















        ' <span class="ch-sub">智能体对话</span></span>' +















      '<div class="ch-actions">' +















        '<button class="sm ghost" onclick="chatNewConv()">+ 新对话</button>' +















        '<button class="sm ghost" onclick="closeModal()">关闭</button>' +















      '</div>' +















    '</div>' +















    '<div class="chat-body">' +















      '<aside class="chat-sidebar">' +















        '<div class="chat-sidebar-h"><span>历史对话</span></div>' +















        '<div id="chatConvList"></div>' +















      '</aside>' +















      '<section class="chat-main">' +















        '<div class="chat-messages" id="chatMsgList"></div>' +















        '<div class="chat-typing" id="chatTyping" style="display:none">' +















          '<span></span><span></span><span></span> 思考中…</div>' +















        '<div class="chat-input-area">' +















          '<div class="chat-input-wrap">' +















            '<textarea class="chat-input" id="chatInput" rows="1" ' +















              'placeholder="输入消息…（Enter 发送，Shift+Enter 换行）" ' +















              'onkeydown="chatKeydown(event)" oninput="autoResize(this)"></textarea>' +















            '<button class="chat-send" id="chatSendBtn" onclick="chatSend()" title="发送">' +















              '<svg width="18" height="18" viewBox="0 0 24 24" fill="none">' +















              '<path d="M3 11.5L21 3l-8.5 18-2.2-7.3L3 11.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>' +















            '</button>' +















          '</div>' +















        '</div>' +















      '</section>' +















    '</div>';















  openModal(html);















  $('modal').className = 'chat-modal';















  chatLoadConvs();















  chatNewConv();















  setTimeout(() => { const el=$('chatInput'); if(el){el.focus(); autoResize(el);} }, 120);















}































function autoResize(el){ el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,140)+'px'; }































function chatKeydown(e){















  if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); chatSend(); }















}































async function chatNewConv(){















  if(CS.sending) return;















  CS.convId = null;















  CS.messages = [];















  renderChatMessages();















  const el=$('chatInput'); if(el){ el.value=''; el.focus(); }















}































async function chatSend(){















  const el=$('chatInput');















  const msg=el.value.trim();















  if(!msg || CS.sending) return;















  el.value='';















  autoResize(el);















  CS.sending=true;















  $('chatSendBtn').disabled=true;















  if(!CS.convId){















    try{















      const r=await api('/api/conversations',{method:'POST',body:JSON.stringify({agent_id:CS.agentId,title:msg.slice(0,40)})});















      CS.convId=r.id;















    }catch(e){ console.error(e); }















  }















  CS.messages.push({role:'user', content:msg});















  renderChatMessages();















  chatScrollBottom();















  $('chatTyping').style.display='flex';















  chatScrollBottom();















  try{















    const r=await api('/api/chat',{method:'POST',body:JSON.stringify({















      conversation_id:CS.convId, agent_id:CS.agentId, message:msg })});















    $('chatTyping').style.display='none';















    if(r.conversation_id) CS.convId=r.conversation_id;















    const isErr=!!r.error;















    const reply=isErr ? ('⚠️ '+(r.error||'调用失败')) : (r.reply||'');















    CS.messages.push({role:'assistant', content:reply, error:isErr, model:r.model||'', mocked:!!r.mocked});















    renderChatMessages();















  }catch(e){















    $('chatTyping').style.display='none';















    CS.messages.push({role:'assistant', content:'⚠️ 请求失败: '+e.message, error:true});















    renderChatMessages();















  }















  chatScrollBottom();















  CS.sending=false;















  $('chatSendBtn').disabled=false;















  el.focus();















  chatLoadConvs();















}































function renderChatMessages(){















  const c=$('chatMsgList');















  if(!c) return;















  if(!CS.messages.length){















    c.innerHTML='<div class="chat-empty"><div style="text-align:center"><div style="font-size:34px;margin-bottom:8px">💬</div>开始一段新对话吧</div></div>';















    return;















  }















  c.innerHTML=CS.messages.map(m=>{















    const cls='chat-msg '+(m.role==='user'?'user':'assistant')+(m.error?' error':'');















    const meta=(m.role==='assistant') ?















      '<div class="cm-meta">'+(m.model?'<span>'+esc(m.model)+'</span>':'')+















      (m.mocked?'<span class="badge b-mock" style="padding:1px 6px;font-size:10px">模拟</span>':'')+'</div>' : '';















    return '<div class="'+cls+'">'+esc(m.content)+meta+'</div>';















  }).join('');















}































function chatScrollBottom(){ const el=$('chatMsgList'); if(el) el.scrollTop=el.scrollHeight; }































async function chatLoadConvs(){















  try{















    const r=await api('/api/conversations?agent_id='+encodeURIComponent(CS.agentId||'')+'&limit=30');















    CS.convs=(r.items||[]);















    const box=$('chatConvList');















    if(!box) return;















    if(!CS.convs.length){















      box.innerHTML='<div class="chat-conv-empty">暂无历史对话<br>发送一条消息开始吧</div>';















      return;















    }















    box.innerHTML=CS.convs.map(cv=>{















      const on=(cv.id===CS.convId)?' on':'';















      const time=cv.last_msg_at?fmtTime(cv.last_msg_at):'';















      return '<div class="chat-conv-item'+on+'" onclick="chatSwitchConv(\''+cv.id+'\')">'+















        '<div class="cc-title">'+esc(cv.title||'未命名对话')+'</div>'+















        '<div class="cc-time">'+time+' · '+(cv.msg_count||0)+' 条</div></div>';















    }).join('');















  }catch(e){ console.error(e); }















}































async function chatSwitchConv(cid){















  if(CS.sending) return;















  CS.convId=cid;















  try{















    const d=await api('/api/conversations/'+cid);















    CS.messages=(d.messages||[]).map(m=>({role:m.role, content:m.content||'', error:!!m.error, model:m.model||'', mocked:!!m.mocked}));















    renderChatMessages();















    chatScrollBottom();















    const all=document.querySelectorAll('.chat-conv-item');















    all.forEach(it=>{















      const oc=it.getAttribute('onclick')||'';















      if(oc.indexOf("'"+cid+"'")>=0) it.classList.add('on'); else it.classList.remove('on');















    });















  }catch(e){ console.error(e); }















}































function fmtTime(ts){















  if(!ts) return '';















  const d=new Date(ts*1000);















  const now=new Date();















  if(d.toDateString()===now.toDateString()) return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);















  return (d.getMonth()+1)+'/'+d.getDate();















}































async function submitRun(aid){































  const a = S.published.filter(x => x.id === aid)[0];































  const miss = checkForm(a.input_schema, 'r');































  if(miss.length){ $('runmsg').textContent = '请填写：' + miss.join('、'); return; }































  $('runmsg').textContent = '提交中…';































  try{































    const r = await api('/api/tasks', {method:'POST', body:JSON.stringify(































      {agent_id:aid, input:readForm(a.input_schema, 'r'), published_only:true})});































    $('runmsg').textContent = '执行中…';































    pollRun(r.id);































  }catch(e){ $('runmsg').innerHTML = '<span style="color:var(--red)">' + esc(e.message) + '</span>'; }































}































function pollRun(tid){































  stopPoll();































  S.timer = setInterval(async () => {































    try{































      const d = await api('/api/tasks/' + tid);































      const t = d.task;































      $('runresult').innerHTML =































        '<div class="card" style="margin-top:14px"><div class="row"><b>' + esc(t.stage || '') + '</b>' +































        '<span class="spacer" style="flex:1"></span><span class="small">' + t.progress + '%</span></div>' +































        '<div class="bar"><i style="width:' + t.progress + '%"></i></div>' +































        (t.error ? '<div class="err">' + esc(t.error) + '</div>' : '') +































        (d.answer ? '<div class="small" style="margin:10px 0 4px">执行结果</div><pre>' + esc(d.answer) + '</pre>' : '') +































        (d.artifacts.length ? '<div class="small" style="margin:10px 0 4px">产物</div>' +































           d.artifacts.map(a => '<div class="kv"><span>' + esc(a.name) + '</span>' +































             '<button class="sm" onclick="dl(\'' + a.id + '\')">下载</button></div>').join('') : '') +































        '</div>';































      if(['done','failed','canceled'].indexOf(t.status) >= 0){ stopPoll(); $('runmsg').textContent = ''; }































    }catch(e){ stopPoll(); }































  }, 2000);































}































function dl(aid){ location.href = '/api/artifacts/' + aid + '/download'; }































































/* ------------------------------------------------------------ 智能体构建 */































async function viewBuild(v, seq){































  if(!S.cat) S.cat = await api('/api/catalog');































  const d = await api('/api/agents?scope=all');































  S.agents = d.items;































  let h = '<div class="flex" style="align-items:flex-start;gap:16px">' +































    '<div style="width:300px"><div class="card"><div class="row" style="margin-bottom:10px">' +































    '<b>智能体</b><span class="spacer" style="flex:1"></span>' +































    '<button class="sm" onclick="newAgent()">+ 新建</button></div>' +































    S.agents.map(a => '<div class="list-item' + (S.cur === a.id ? ' on' : '') + '" onclick="editAgent(\'' + a.id + '\')">' +































      '<div class="row"><span>' + esc(a.icon || '') + '</span><b>' + esc(a.name) + '</b>' +































      '<span class="spacer" style="flex:1"></span>' + statusBadge(a) + '</div>' +































      '<div class="small">' + esc(a.category || '') + ' · ' + esc(rtName(a.runtime)) + '</div></div>').join('') +































    '</div></div><div class="col" id="editor"></div></div>';































  setView(v, seq, h);































  if(!$('editor')) return;































  if(S.cur) await renderEditor(S.cur);































  else $('editor').innerHTML = '<div class="empty">从左侧选择一个智能体进行编辑，或点击「+ 新建」从零创建</div>';































}































function statusBadge(a){































  if(a.status === 'published') return '<span class="badge b-pub">已发布 v' + a.version + '</span>';































  if(a.status === 'archived')  return '<span class="badge b-arch">已归档</span>';































  return '<span class="badge b-draft">草稿</span>';































}































function newAgent(){































  S.cur = null;































  S.editing = {name:'', icon:'A', category:'通用', description:'', persona:'',































               runtime:'chat', output:'markdown', skills:[], tools:[], input_schema:[],































               temperature:0.4, model:''};































  renderEditor(null);































}































async function editAgent(aid){ S.cur = aid; await renderEditor(aid); }































































async function renderEditor(aid){































  if(!MP.loaded){ try{ await loadModels(false); }catch(e){ /* 离线时静默，下拉为空可手填 */ } }































  let a = S.editing;































  if(aid){































    const d = await api('/api/agents/' + aid);































    a = S.editing = {id:d.id, name:d.name, icon:d.icon || 'A', category:d.category || '通用',































      description:d.description || '', persona:d.persona || '', runtime:d.runtime || 'chat',































      output:d.output || 'markdown', skills:(d.skills || []).map(s => s.id),































      tools:(d.tools || []).map(t => t.name), input_schema:d.input_schema || [],































      temperature:d.temperature || 0.4, model:d.model || ''};































    S.editing._status = d.status; S.editing._origin = d.origin; S.editing._version = d.version;































  }































  const E = S.editing;































  const icons = ['A','W','P','#','*','Q','M','L','T','S','G','D'];































  let h = '<div class="card"><div class="row" style="margin-bottom:12px">' +































    '<b style="font-size:15px">' + (aid ? '编辑智能体' : '新建智能体') + '</b>' +































    (aid ? '<span class="spacer" style="flex:1"></span>' + statusBadge({status:E._status, version:E._version}) : '') +































    '</div>' +































    '<div class="flex"><div class="col"><div class="field"><label>名称 *</label>' +































    '<input id="e_name" value="' + esc(E.name) + '" placeholder="例如：投标答疑智能体"></div>' +































    '<div class="field"><label>分类</label><input id="e_cat" value="' + esc(E.category) + '"></div></div>' +































    '<div class="col" style="max-width:230px"><div class="field"><label>图标</label>' +































    '<div class="chips">' + icons.map(i => '<span class="chip" style="cursor:pointer;font-size:13px;' +































      (E.icon === i ? 'border-color:var(--green);background:rgba(34,197,94,.12)' : '') +































      '" onclick="pickIcon(\'' + i + '\')">' + i + '</span>').join('') + '</div></div></div></div>' +































    '<div class="field"><label>简介（业务人员在工作台看到的说明）</label>' +































    '<input id="e_desc" value="' + esc(E.description) + '"></div>' +































    '<div class="field"><label>人设 / System Prompt - 决定它是什么角色、怎么说话</label>' +































    '<textarea id="e_persona" style="min-height:110px" placeholder="例如：你是资深投标专家，负责将招标要求转化为应答条款……">' +































    esc(E.persona) + '</textarea></div>' +































    '<div class="field"><label>执行引擎</label><div class="grid g2">' +































    S.cat.runtimes.map(r => '<div class="rt' + (E.runtime === r.id ? ' on' : '') + '" onclick="pickRuntime(\'' + r.id + '\')">' +































      '<b>' + r.name + '</b><div>' + r.desc + '</div>' + '<div class="small" style="margin-top:6px"><span style="cursor:pointer;text-decoration:underline" onclick="event.stopPropagation();runtimeDetail(\'' + r.id + '\')">查看详情</span></div>' + '</div>').join('') + '</div></div>' +































    '<div class="field"><label>输出类型</label><select id="e_out">' +































    S.cat.outputs.map(o => '<option value="' + o.id + '"' + (E.output === o.id ? ' selected' : '') + '>' + o.name + '</option>').join('') +































    '</select></div></div>';































































  h += '<div class="card"><b style="font-size:15px">挂载技能</b>' +































    '<div class="small" style="margin:4px 0 10px">技能是可复用的作业规范，会被拼进系统提示词；改一次技能，所有引用它的智能体同步生效</div>' +































    (S.cat.skills.length ? S.cat.skills.map(s => '<div class="chk' + (E.skills.indexOf(s.id) >= 0 ? ' on' : '') +































      '" onclick="toggleItem(\'skills\',\'' + s.id + '\',this)"><input type="checkbox" ' +































      (E.skills.indexOf(s.id) >= 0 ? 'checked' : '') + '><div><b>' + esc(s.name) + '</b>' +































      '<div class="small">' + esc(s.description || '') + ' · ' + s.chars + ' 字 · <span style="cursor:pointer;text-decoration:underline" onclick="event.stopPropagation();openSkillFromBuilder(\'' + s.id + '\')">查看正文</span></div></div></div>').join('')































      : '<div class="small">暂无技能，可到「技能库」新建</div>') + '</div>';































































  h += '<div class="card"><b style="font-size:15px">挂载工具</b>' +































    '<div class="small" style="margin:4px 0 10px">内置工具与已接入的 MCP 工具统一在此；对话引擎下模型可自主调用，长文档引擎按章节自动检索</div>' +































    S.cat.tools.map(t => '<div class="chk' + (E.tools.indexOf(t.name) >= 0 ? ' on' : '') +































      '" onclick="toggleItem(\'tools\',\'' + t.name + '\',this)"><input type="checkbox" ' +































      (E.tools.indexOf(t.name) >= 0 ? 'checked' : '') + '><div><b>' + esc(t.name) + '</b> ' +































      '<span class="badge b-src">' + esc(t.source) + (t.server ? ' · ' + esc(t.server) : '') + '</span>' +































      '<div class="small">' + esc(t.description || '') + '</div></div></div>').join('') + '</div>';































































  h += '<div class="card"><div class="row" style="margin-bottom:10px"><b style="font-size:15px">输入表单</b>' +































    '<span class="spacer" style="flex:1"></span><button class="sm ghost" onclick="addField()">+ 添加字段</button></div>' +































    '<div class="small" style="margin-bottom:10px">定义业务人员使用时看到的输入框</div>' +































    '<div id="fields">' + fieldsHTML(E.input_schema) + '</div></div>';































































  h += '<div class="card"><div class="flex"><div class="col field"><label>温度（0 严谨 ~ 1 发散）</label>' +































    '<input id="e_temp" type="number" step="0.1" min="0" max="1" value="' + esc(E.temperature) + '"></div>' +































    '<div class="col field"><label>指定模型（留空用全局默认）</label>' +































    '<input id="e_md_q" placeholder="搜索模型…" oninput="filterModel(\'e_md\')" style="margin-bottom:6px">' +































    '<select id="e_md_sel" onchange="onModelPick(\'e_md\')"></select>' +































    '<div class="small" id="e_md_info" style="margin-top:4px"></div></div></div>' +































    '<div class="row" style="margin-top:12px;flex-wrap:wrap">' +































    '<button onclick="saveAgent()">保存草稿</button>' +































    '<button class="ghost" onclick="doTest()">试运行</button>' +































    '<button class="ghost" onclick="viewPrompt()">查看生效提示词</button>' +































    (aid ? '<button class="ghost" onclick="doPublish(\'' + aid + '\')">发布</button>' : '') + (aid ? '<button class="ghost" onclick="doEnableToggle(\'' + aid + '\')">' + (E.enabled ? '停用' : '启用') + '</button>' : '') +































    (aid && E._status === 'published' ? '<button class="ghost" onclick="doUnpublish(\'' + aid + '\')">下线</button>' : '') +































    (aid ? '<button class="ghost" onclick="doClone(\'' + aid + '\')">复制</button>' : '') +































    (aid && E._origin === 'custom' ? '<button class="danger" onclick="doDelete(\'' + aid + '\')">删除</button>' : '') +

    (aid && E._status !== 'archived' ? '<button class="ghost" onclick="doArchive(\'' + aid + '\')">归档</button>' : '') +

    (aid && E._status === 'archived' ? '<button class="ghost" onclick="doUnarchive(\'' + aid + '\')">恢复</button>' : '') +

    (aid ? '<button class="ghost" onclick="viewVersions(\'' + aid + '\')">版本历史</button>' : '') +































    '</div><div id="edmsg" style="margin-top:10px"></div><div id="verPanel" style="margin-top:12px"></div><div id="testout"></div></div>';































  if($('editor')) $('editor').innerHTML = h;































  bindModelField('e_md', E.model || '', '（跟随全局默认）');































}































function fieldsHTML(schema){































  if(!schema || !schema.length) return '<div class="small">还没有字段，业务人员将只看到一个默认输入框</div>';































  return schema.map((f, i) => '<div class="flex" style="margin-bottom:8px;align-items:flex-end">' +































    '<div class="col"><label>字段标识</label><input value="' + esc(f.key) + '" oninput="setField(' + i + ',\'key\',this.value)"></div>' +































    '<div class="col"><label>显示名</label><input value="' + esc(f.label || '') + '" oninput="setField(' + i + ',\'label\',this.value)"></div>' +































    '<div class="col" style="max-width:120px"><label>类型</label><select onchange="setField(' + i + ',\'type\',this.value)">' +































    ['text','textarea','number'].map(t => '<option value="' + t + '"' + (f.type === t ? ' selected' : '') + '>' + t + '</option>').join('') +































    '</select></div>' +































    '<div class="col" style="max-width:70px"><label>必填</label><select onchange="setField(' + i + ',\'required\',this.value===\'1\')">' +































    '<option value="0"' + (f.required ? '' : ' selected') + '>否</option><option value="1"' + (f.required ? ' selected' : '') + '>是</option></select></div>' +































    '<button class="sm danger" onclick="delField(' + i + ')">删</button></div>').join('');































}































function setField(i, k, v){ S.editing.input_schema[i][k] = v; }































function addField(){































  S.editing.input_schema.push({key:'field' + (S.editing.input_schema.length + 1),































    label:'新字段', type:'textarea', required:false});































  $('fields').innerHTML = fieldsHTML(S.editing.input_schema);































}































function delField(i){ S.editing.input_schema.splice(i, 1); $('fields').innerHTML = fieldsHTML(S.editing.input_schema); }































function pickIcon(i){ S.editing.icon = i; renderEditor(S.cur); }































async function openSkillFromBuilder(sid){
  S.tab = 'skill';
  renderTabs();
  await render();
  await editSkill(sid);
}
function runtimeDetail(rid){
  const r = ((S.cat && S.cat.runtimes) || []).filter(x => x.id === rid)[0] || {id:rid, name:rid, desc:''};
  const d = ((S.cat && S.cat.runtime_details) || {})[rid] || {};
  const rowOf = (k, v) => v ? '<div class="field" style="margin-bottom:10px"><label>' + k + '</label><div style="font-size:13px;line-height:1.6">' + esc(v) + '</div></div>' : '';
  const chips = (d.tags || []).map(t => '<span class="pill">' + esc(t) + '</span>').join(' ');
  openModal('<div class="row"><b style="font-size:16px">' + esc(r.name) + '</b>' +
    '<span class="spacer" style="flex:1"></span>' +
    '<button class="ghost sm" onclick="closeModal()">关闭</button></div>' +
    '<div class="small" style="margin:6px 0 4px">' + esc(r.desc || '') + '</div>' +
    (chips ? '<div style="margin:8px 0 14px">' + chips + '</div>' : '') +
    rowOf('适用场景', d.usage) + rowOf('工作机制', d.mechanism) +
    rowOf('典型输入', d.inputs) + rowOf('产出物', d.artifacts) +
    rowOf('断点续跑', d.resumable) + rowOf('工具 / 技能', d.tools));
}
async function viewEngine(v, seq){
  if(!S.cat) S.cat = await api('/api/catalog');
  const d = await api('/api/engines');
  S.engines = d.items || [];
  let h = '<div class="flex" style="align-items:flex-start;gap:16px">' +
    '<div style="width:300px"><div class="card"><div class="row" style="margin-bottom:10px">' +
    '<b>执行引擎</b><span class="spacer" style="flex:1"></span>' +
    '<span class="small">' + S.engines.length + ' 个</span></div>' +
    (S.engines.length ? S.engines.map(e => '<div class="list-item' + (S.curEngine === e.id ? ' on' : '') +
      '" onclick="openEngine(\'' + e.id + '\')"><div class="row"><b>' + esc(e.name) + '</b>' +
      '<span class="spacer" style="flex:1"></span><span class="badge">v' + e.version + '</span></div>' +
      '<div class="small">' + esc(e.id) + (e.enabled ? '' : ' · 已停用') + '</div></div>').join('')
      : '<div class="small">暂无引擎</div>') + '</div></div>' +
    '<div class="col" id="engedit"></div></div>';
  setView(v, seq, h);
  if(!$('engedit')) return;
  if(S.curEngine) await renderEngine(S.curEngine);
  else $('engedit').innerHTML = '<div class="empty">从左侧选择一个执行引擎，查看详情、可调参数与版本历史</div>';
}
async function openEngine(eid){ S.curEngine = eid; await render(); }
function _engTs(ts){ if(!ts) return '-'; const d = new Date(ts*1000); const p = n => ('0'+n).slice(-2); return (d.getMonth()+1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()); }
async function renderEngine(eid){
  const e = await api('/api/engines/' + eid);
  const el = $('engedit'); if(!el) return;
  const sp = e.spec || {}, dt = sp.detail || {}, pm = sp.param_meta || {}, pv = sp.params || {};
  let ph = '';
  const pks = Object.keys(pm);
  if(pks.length){
    ph = '<div class="field"><label>可调参数（保存后即时生效）</label><div class="flex" style="gap:12px;flex-wrap:wrap">' +
      pks.map(k => { const m = pm[k] || {};
        return '<div class="col" style="min-width:150px"><div class="small">' + esc(m.label || k) + (m.unit ? '（' + esc(m.unit) + '）' : '') + '</div>' +
        '<input id="ep_' + k + '" type="number" min="' + (m.min != null ? m.min : '') + '" max="' + (m.max != null ? m.max : '') + '" value="' + (pv[k] != null ? pv[k] : '') + '">' +
        (m.hint ? '<div class="small">' + esc(m.hint) + '</div>' : '') + '</div>'; }).join('') + '</div></div>';
  }
  el.innerHTML =
    '<div class="card"><div class="row"><b style="font-size:15px">' + esc(sp.name || eid) + '</b>' +
    '<span class="badge">当前 v' + e.version + '</span><span class="spacer" style="flex:1"></span>' +
    '<label class="small" style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="e_en" ' + (e.enabled ? 'checked' : '') + '> 启用</label>' +
    '<button onclick="saveEngine(\'' + eid + '\')">保存为新版本</button></div>' +
    '<div class="small" style="margin:6px 0 12px">标识 ' + esc(eid) + ' · 执行逻辑：' + esc(sp.code_impl || '（由代码实现）') + ' · 此处只管理定义与参数，不改执行逻辑</div>' +
    '<div class="field"><label>名称</label><input id="e_ename" value="' + esc(sp.name || '') + '"></div>' +
    '<div class="field"><label>一句话说明</label><input id="e_edesc" value="' + esc(sp.desc || '') + '"></div>' +
    '<div class="field"><label>适用场景</label><input id="ed_usage" value="' + esc(dt.usage || '') + '"></div>' +
    '<div class="field"><label>工作机制</label><input id="ed_mechanism" value="' + esc(dt.mechanism || '') + '"></div>' +
    '<div class="flex"><div class="col field"><label>典型输入</label><input id="ed_inputs" value="' + esc(dt.inputs || '') + '"></div>' +
    '<div class="col field"><label>产出物</label><input id="ed_artifacts" value="' + esc(dt.artifacts || '') + '"></div></div>' +
    '<div class="flex"><div class="col field"><label>断点续跑</label><input id="ed_resumable" value="' + esc(dt.resumable || '') + '"></div>' +
    '<div class="col field"><label>工具 / 技能</label><input id="ed_tools" value="' + esc(dt.tools || '') + '"></div></div>' +
    ph +
    '<div class="row"><button onclick="saveEngine(\'' + eid + '\')">保存为新版本</button><span id="emsg" class="small"></span></div></div>' +
    '<div class="card" style="margin-top:14px"><div class="row" style="margin-bottom:8px"><b style="font-size:15px">版本历史</b>' +
    '<span class="spacer" style="flex:1"></span><span class="small">最近 50 条</span></div>' +
    ((e.versions || []).map(vv => '<div class="row" style="padding:8px 0;border-top:1px solid var(--line)">' +
      '<span class="badge">v' + vv.version + '</span><span style="flex:1">' + esc(vv.note || '') + '</span>' +
      '<span class="small">' + _engTs(vv.created_at) + '</span>' +
      (vv.version !== e.version ? '<button class="sm" onclick="rollbackEngine(\'' + eid + '\',' + vv.version + ')">回滚</button>' : '<span class="small">当前</span>') +
      '</div>').join('') || '<div class="small">暂无历史</div>') + '</div>';
}
async function saveEngine(eid){
  const g = id => ($(id) ? $(id).value : '');
  const params = {};
  document.querySelectorAll('[id^="ep_"]').forEach(inp => {
    const k = inp.id.slice(3); const val = inp.value.replace(/[^0-9.\-]/g, '');
    if(val !== '') params[k] = Number(val);
  });
  const body = { name: g('e_ename'), desc: g('e_edesc'),
    detail: { usage: g('ed_usage'), mechanism: g('ed_mechanism'), inputs: g('ed_inputs'), artifacts: g('ed_artifacts'), resumable: g('ed_resumable'), tools: g('ed_tools') },
    params: params, enabled: ($('e_en') ? $('e_en').checked : true), note: '界面更新' };
  try{
    await api('/api/engines/' + eid, {method:'POST', body: JSON.stringify(body)});
    S.cat = await api('/api/catalog');
    await render();
    msg2('emsg', '已保存为新版本');
  }catch(err){ if($('emsg')) $('emsg').innerHTML = '<span style="color:var(--red)">' + esc(err.message) + '</span>'; }
}
async function rollbackEngine(eid, ver){
  if(!confirm('回滚到 v' + ver + '？将以该版本内容创建一个新版本。')) return;
  await api('/api/engines/' + eid + '/rollback', {method:'POST', body: JSON.stringify({version: ver})});
  S.cat = await api('/api/catalog');
  await render();
}
function pickRuntime(r){































  S.editing.runtime = r;































  S.editing.output = r === 'doc' ? 'docx' : (r === 'ppt' ? 'pptx' : S.editing.output);































  renderEditor(S.cur);































}































function toggleItem(arr, id, el){































  const a = S.editing[arr]; const i = a.indexOf(id);































  if(i >= 0) a.splice(i, 1); else a.push(id);































  el.classList.toggle('on');































  const box = el.querySelector('input'); if(box) box.checked = !box.checked;































}































function collect(){































  const E = S.editing;































  return Object.assign({}, E, {































    name:$('e_name').value.trim(), category:$('e_cat').value.trim() || '通用',































    description:$('e_desc').value.trim(), persona:$('e_persona').value,































    output:$('e_out').value, temperature:parseFloat($('e_temp').value || '0.4'),































    model:($('e_md_sel') ? $('e_md_sel').value : '') || '',































    input_schema:E.input_schema, skills:E.skills, tools:E.tools, runtime:E.runtime, icon:E.icon});































}































async function saveAgent(){































  const body = collect();































  if(!body.name){ msg('edmsg', 'err', '名称不能为空'); return; }































  if(!body.input_schema.length) body.input_schema = [{key:'brief', label:'需求描述', type:'textarea', required:true}];































  if(!body.persona.trim()) body.persona = '你是资深业务专家，回答需结构清晰、结论先行、可落地，避免空话。';































  try{































    const r = S.cur ? await api('/api/agents/' + S.cur, {method:'PUT', body:JSON.stringify(body)})































                    : await api('/api/agents', {method:'POST', body:JSON.stringify(body)});































    S.cur = r.id; S.editing = null;































    await render();































    msg('edmsg', 'ok', '已保存草稿「' + r.name + '」。草稿改动不会影响线上已发布版本，确认无误后点击发布。');































  }catch(e){ msg('edmsg', 'err', e.message); }































}































function msg2(id, text){ if($(id)) $(id).innerHTML = '<span style="color:var(--green)">' + esc(text) + '</span>'; }































function msg(id, cls, text){ $(id).innerHTML = '<div class="' + cls + '">' + esc(text) + '</div>'; }































async function doPublish(aid){































  try{































    await api('/api/agents/' + (S.cur || aid) + '/publish', {method:'POST', body:JSON.stringify({note:'界面发布'})});































    S.editing = null; render();































    setTimeout(() => msg('edmsg', 'ok', '已发布，业务人员现在可以在工作台看到并使用它'), 60);































  }catch(e){ msg('edmsg', 'err', e.message); }































}































async function doUnpublish(aid){































