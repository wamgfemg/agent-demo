# -*- coding: utf-8 -*-
"""SQLite 数据层：同时承担存储与任务队列职责，省掉 Redis/Postgres。"""
import sqlite3, json, time, threading, os, uuid
from .config import DB_PATH

_lock = threading.Lock()

SCHEMA = """
CREATE TABLE IF NOT EXISTS settings(
  key TEXT PRIMARY KEY,
  value TEXT,
  updated_at REAL
);
CREATE TABLE IF NOT EXISTS agents(
  id TEXT PRIMARY KEY,
  name TEXT,
  category TEXT,
  description TEXT,
  spec_json TEXT,
  enabled INTEGER DEFAULT 1,
  created_at REAL,
  updated_at REAL,
  status TEXT DEFAULT 'published',
  origin TEXT DEFAULT 'yaml',
  icon TEXT,
  version INTEGER DEFAULT 1,
  published_json TEXT,
  published_at REAL
);
CREATE TABLE IF NOT EXISTS agent_versions(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  agent_id TEXT,
  version INTEGER,
  spec_json TEXT,
  note TEXT,
  created_at REAL
);

CREATE TABLE IF NOT EXISTS engine_defs(
  engine_id TEXT PRIMARY KEY,
  name TEXT,
  current_version INTEGER DEFAULT 1,
  enabled INTEGER DEFAULT 1,
  updated_at REAL
);
CREATE TABLE IF NOT EXISTS engine_versions(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  engine_id TEXT,
  version INTEGER,
  spec_json TEXT,
  note TEXT,
  created_at REAL
);
CREATE TABLE IF NOT EXISTS tasks(
  id TEXT PRIMARY KEY,
  agent_id TEXT,
  title TEXT,
  input_json TEXT,
  params_json TEXT,
  status TEXT,
  progress INTEGER DEFAULT 0,
  stage TEXT,
  error TEXT,
  tokens_in INTEGER DEFAULT 0,
  tokens_out INTEGER DEFAULT 0,
  cost REAL DEFAULT 0,
  created_at REAL,
  updated_at REAL
);
CREATE TABLE IF NOT EXISTS task_units(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id TEXT,
  unit_key TEXT,
  seq INTEGER,
  title TEXT,
  stage TEXT,
  status TEXT,
  attempt INTEGER DEFAULT 0,
  input_json TEXT,
  output_json TEXT,
  review_json TEXT,
  tokens_in INTEGER DEFAULT 0,
  tokens_out INTEGER DEFAULT 0,
  error TEXT,
  created_at REAL,
  updated_at REAL
);
CREATE TABLE IF NOT EXISTS artifacts(
  id TEXT PRIMARY KEY,
  task_id TEXT,
  name TEXT,
  path TEXT,
  mime TEXT,
  size INTEGER,
  created_at REAL
);
CREATE TABLE IF NOT EXISTS glossary(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id TEXT,
  term TEXT,
  definition TEXT
);
CREATE TABLE IF NOT EXISTS numbers(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id TEXT,
  key TEXT,
  value TEXT,
  unit TEXT,
  source TEXT
);
CREATE TABLE IF NOT EXISTS traces(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id TEXT,
  unit_id INTEGER,
  role TEXT,
  model TEXT,
  mocked INTEGER DEFAULT 0,
  tokens_in INTEGER DEFAULT 0,
  tokens_out INTEGER DEFAULT 0,
  latency_ms INTEGER,
  created_at REAL
);
CREATE TABLE IF NOT EXISTS mcp_servers(
  id TEXT PRIMARY KEY,
  name TEXT,
  transport TEXT,
  url TEXT,
  command TEXT,
  args_json TEXT,
  env_json TEXT,
  headers_json TEXT,
  enabled INTEGER DEFAULT 1,
  status TEXT,
  tools_json TEXT,
  last_error TEXT,
  updated_at REAL
);
CREATE TABLE IF NOT EXISTS tool_calls(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id TEXT,
  tool TEXT,
  source TEXT,
  args_json TEXT,
  ok INTEGER,
  ms INTEGER,
  created_at REAL
);
CREATE TABLE IF NOT EXISTS conversations(
  id TEXT PRIMARY KEY,
  agent_id TEXT,
  title TEXT,
  created_at REAL,
  updated_at REAL
);
CREATE TABLE IF NOT EXISTS chat_messages(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  conversation_id TEXT,
  role TEXT,
  content TEXT,
  model TEXT,
  mocked INTEGER DEFAULT 0,
  tokens_in INTEGER DEFAULT 0,
  tokens_out INTEGER DEFAULT 0,
  latency_ms INTEGER DEFAULT 0,
  error TEXT,
  created_at REAL
);
CREATE INDEX IF NOT EXISTS idx_units_task ON task_units(task_id);
CREATE INDEX IF NOT EXISTS idx_art_task ON artifacts(task_id);
CREATE INDEX IF NOT EXISTS idx_msg_conv ON chat_messages(conversation_id);
CREATE INDEX IF NOT EXISTS idx_conv_agent ON conversations(agent_id);
"""

DEFAULTS = {
    "llm_base_url": "https://openrouter.ai/api/v1",
    "llm_api_key": "",
    "llm_model": "openai/gpt-4o-mini",
    "llm_model_strong": "openai/gpt-4o-mini",
    "llm_app_name": "AgentForge",
}


def conn():
    c = sqlite3.connect(DB_PATH, timeout=30, check_same_thread=False)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA synchronous=NORMAL")
    return c


def _table_cols(table):
    with _lock:
        c = conn()
        cols = [r["name"] for r in c.execute(f"PRAGMA table_info({table})").fetchall()]
        c.close()
    return set(cols)


def migrate():
    """线上已有库结构升级：只补列，不动数据。"""
    cols = _table_cols("agents")
    for col, ddl in (("updated_at", "REAL"), ("status", "TEXT DEFAULT 'published'"),
                     ("origin", "TEXT DEFAULT 'yaml'"), ("icon", "TEXT"),
                     ("version", "INTEGER DEFAULT 1"), ("published_json", "TEXT"),
                     ("published_at", "REAL")):
        if col not in cols:
            execute(f"ALTER TABLE agents ADD COLUMN {col} {ddl}")
    execute("UPDATE agents SET status='published' WHERE status IS NULL OR status=''")
    # 新增对话表（如果不存在）
    existing_tables = set()
    with _lock:
        c2 = conn()
        for row in c2.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall():
            existing_tables.add(row["name"])
        c2.close()
    if "conversations" not in existing_tables:
        with _lock:
            cc = conn()
            cc.executescript("""
                CREATE TABLE conversations(
                  id TEXT PRIMARY KEY,
                  agent_id TEXT,
                  title TEXT,
                  created_at REAL,
                  updated_at REAL
                );
                CREATE TABLE chat_messages(
                  id INTEGER PRIMARY KEY AUTOINCREMENT,
                  conversation_id TEXT,
                  role TEXT,
                  content TEXT,
                  model TEXT,
                  mocked INTEGER DEFAULT 0,
                  tokens_in INTEGER DEFAULT 0,
                  tokens_out INTEGER DEFAULT 0,
                  latency_ms INTEGER DEFAULT 0,
                  error TEXT,
                  created_at REAL
                );
                CREATE INDEX idx_msg_conv ON chat_messages(conversation_id);
                CREATE INDEX idx_conv_agent ON conversations(agent_id);
            """)
            cc.commit()
            cc.close()


def init_db():
    with _lock:
        c = conn()
        c.executescript(SCHEMA)
        now = time.time()
        for k, v in DEFAULTS.items():
            c.execute("INSERT OR IGNORE INTO settings(key,value,updated_at) VALUES(?,?,?)", (k, v, now))
        c.commit()
        c.close()
    migrate()


def now():
    return time.time()


def get_setting(key, default=None):
    with _lock:
        c = conn()
        r = c.execute("SELECT value FROM settings WHERE key=?", (key,)).fetchone()
        c.close()
    return r["value"] if r else default


def set_settings(d: dict):
    with _lock:
        c = conn()
        for k, v in d.items():
            c.execute("INSERT OR IGNORE INTO settings(key,value,updated_at) VALUES(?,?,?) "
                      "ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at",
                      (k, str(v), now()))
        c.commit()
        c.close()


def all_settings():
    with _lock:
        c = conn()
        rows = c.execute("SELECT key,value FROM settings").fetchall()
        c.close()
    return {r["key"]: r["value"] for r in rows}


def execute(sql, args=()):
    with _lock:
        c = conn()
        cur = c.execute(sql, args)
        c.commit()
        rid = cur.lastrowid
        c.close()
    return rid


def query(sql, args=()):
    with _lock:
        c = conn()
        rows = [dict(r) for r in c.execute(sql, args).fetchall()]
        c.close()
    return rows


def query_one(sql, args=()):
    r = query(sql, args)
    return r[0] if r else None


def update_task(task_id, **kw):
    kw["updated_at"] = now()
    cols = ",".join(f"{k}=?" for k in kw)
    execute(f"UPDATE tasks SET {cols} WHERE id=?", tuple(kw.values()) + (task_id,))


def upsert_agent(spec: dict, origin=None, status=None, touch=True):
    aid = spec["id"]
    row = query_one("SELECT origin,status FROM agents WHERE id=?", (aid,))
    if row and not touch:
        return False
    if row:
        execute("UPDATE agents SET name=?,category=?,description=?,icon=?,spec_json=?,updated_at=? "
                "WHERE id=?",
                (spec.get("name"), spec.get("category"), spec.get("description"), spec.get("icon"),
                 json.dumps(spec, ensure_ascii=False), now(), aid))
    else:
        pub_at = now() if (status or "published") == "published" else None
        execute("INSERT INTO agents(id,name,category,description,icon,spec_json,enabled,created_at,"
                "updated_at,status,origin,version,published_at) VALUES(?,?,?,?,?,?,1,?,?,?,?,1,?)",
                (aid, spec.get("name"), spec.get("category"), spec.get("description"), spec.get("icon"),
                 json.dumps(spec, ensure_ascii=False), now(), now(),
                 status or "published", origin or "yaml", pub_at))
    return True


def publish_agent(aid, note=""):
    row = query_one("SELECT spec_json,version FROM agents WHERE id=?", (aid,))
    if not row:
        return None
    ver = (row["version"] or 1)
    execute("INSERT INTO agent_versions(agent_id,version,spec_json,note,created_at) VALUES(?,?,?,?,?)",
            (aid, ver, row["spec_json"], note or "", now()))
    execute("UPDATE agents SET status='published',published_json=?,published_at=?,version=version+1,"
            "updated_at=? WHERE id=?", (row["spec_json"], now(), now(), aid))
    return ver


def unpublish_agent(aid):
    execute("UPDATE agents SET status='draft',updated_at=? WHERE id=?", (now(), aid))


def agent_versions(aid):
    return query("SELECT id,version,note,created_at FROM agent_versions WHERE agent_id=? "
                 "ORDER BY version DESC LIMIT 20", (aid,))


def add_trace(task_id, unit_id, role, model, mocked, tin, tout, latency_ms):
    execute("INSERT INTO traces(task_id,unit_id,role,model,mocked,tokens_in,tokens_out,latency_ms,created_at)"
            " VALUES(?,?,?,?,?,?,?,?,?)",
            (task_id, unit_id, role, model, 1 if mocked else 0, tin, tout, latency_ms, now()))


def log_tool_call(task_id, tool, source, args, ok, ms):
    try:
        execute("INSERT INTO tool_calls(task_id,tool,source,args_json,ok,ms,created_at)"
                " VALUES(?,?,?,?,?,?,?)",
                (task_id, tool, source, j(args or {})[:2000], 1 if ok else 0, ms, now()))
    except Exception:
        pass


# ==================== 对话历史 ====================

def create_conversation(agent_id, title=""):
    cid = uuid.uuid4().hex[:12]
    t = now()
    execute("INSERT INTO conversations(id,agent_id,title,created_at,updated_at) VALUES(?,?,?,?,?)",
            (cid, agent_id or "", title or "", t, t))
    return cid


def list_conversations(agent_id=None, limit=30):
    if agent_id:
        return query("SELECT c.*, COUNT(m.id) AS msg_count, "
                     "MAX(m.created_at) AS last_msg_at "
                     "FROM conversations c LEFT JOIN chat_messages m ON m.conversation_id=c.id "
                     "WHERE c.agent_id=? GROUP BY c.id ORDER BY c.updated_at DESC LIMIT ?",
                     (agent_id, limit))
    return query("SELECT c.*, COUNT(m.id) AS msg_count, "
                 "MAX(m.created_at) AS last_msg_at "
                 "FROM conversations c LEFT JOIN chat_messages m ON m.conversation_id=c.id "
                 "GROUP BY c.id ORDER BY c.updated_at DESC LIMIT ?", (limit,))


def get_conversation(cid):
    conv = query_one("SELECT * FROM conversations WHERE id=?", (cid,))
    if not conv:
        return None
    msgs = query("SELECT * FROM chat_messages WHERE conversation_id=? ORDER BY created_at ASC", (cid,))
    return {"conversation": conv, "messages": msgs}


def add_chat_message(conv_id, role, content, model="", mocked=False, tin=0, tout=0, latency_ms=0, error=None):
    rid = execute("INSERT INTO chat_messages(conversation_id,role,content,model,mocked,tokens_in,tokens_out,latency_ms,error,created_at) "
                  "VALUES(?,?,?,?,?,?,?,?,?,?)",
                  (conv_id, role, content, model, 1 if mocked else 0, tin, tout, latency_ms, error, now()))
    execute("UPDATE conversations SET updated_at=? WHERE id=?", (now(), conv_id))
    return rid


def delete_conversation(cid):
    execute("DELETE FROM chat_messages WHERE conversation_id=?", (cid,))
    execute("DELETE FROM conversations WHERE id=?", (cid,))


def j(o):
    return json.dumps(o, ensure_ascii=False)


def uj(s, default=None):
    if not s:
        return default
    try:
        return json.loads(s)
    except Exception:
        return default
