@app.get("/api/settings")



def get_settings():



    s = db.all_settings()



    masked = dict(s)



    if masked.get("llm_api_key"):



        k = masked["llm_api_key"]



        masked["llm_api_key"] = k[:6] + "..." + k[-4:] if len(k) > 12 else "***"



    return {"settings": masked, "mocked": llm.is_mocked()}











